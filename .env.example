APP_NAME=Self Hosted Text-to-Video Generator
ENVIRONMENT=production
LOG_LEVEL=INFO

API_PORT=8000
FLOWER_PORT=5555
# Leave unset to disable Flower basic auth. Set to user:password to enable.
# FLOWER_BASIC_AUTH=admin:change-me
HOST_WEB_ROOT=/var/www/html
# Put this on a large disk in production, for example /mnt/ai-models/text-to-video-generator
HOST_MODEL_ROOT=./models
INSTALL_LTX=true
LTX_REF=main
LTX_UV_SYNC_ARGS=--frozen --no-dev --package ltx-pipelines
NVIDIA_VISIBLE_DEVICES=all

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
JOB_TTL_SECONDS=604800

GENERATOR_BACKEND=ltx23
OUTPUT_ALLOWED_ROOTS=/var/www/html,/app/output
OUTPUT_ROOT_GUARD_ENABLED=true
OUTPUT_FILE_INDEX_BASE=0
OVERWRITE_OUTPUTS=true

TARGET_FPS=30
TARGET_LANDSCAPE_WIDTH=1920
TARGET_LANDSCAPE_HEIGHT=1080
TARGET_PORTRAIT_WIDTH=1080
TARGET_PORTRAIT_HEIGHT=1920
USE_MOTION_INTERPOLATION=false

LTX_PYTHON=/opt/LTX-2/.venv/bin/python
LTX_REPO_PATH=/opt/LTX-2
LTX_PIPELINE=hq
LTX_CHECKPOINT_PATH=/models/LTX-2.3/ltx-2.3-22b-dev.safetensors
LTX_DISTILLED_CHECKPOINT_PATH=/models/LTX-2.3/ltx-2.3-22b-distilled-1.1.safetensors
LTX_DISTILLED_LORA_PATH=/models/LTX-2.3/ltx-2.3-22b-distilled-lora-384-1.1.safetensors
LTX_SPATIAL_UPSAMPLER_PATH=/models/LTX-2.3/ltx-2.3-spatial-upscaler-x2-1.1.safetensors
LTX_GEMMA_ROOT=/models/gemma-3-12b-it-qat-q4_0-unquantized
LTX_QUANTIZATION=fp8-cast
LTX_OFFLOAD_MODE=none
LTX_MAX_BATCH_SIZE=1
LTX_NUM_INFERENCE_STEPS=15
LTX_MODEL_FRAME_RATE=48
LTX_LANDSCAPE_WIDTH=1920
LTX_LANDSCAPE_HEIGHT=1088
LTX_PORTRAIT_WIDTH=1088
LTX_PORTRAIT_HEIGHT=1920
LTX_ENHANCE_PROMPT=true
LTX_DISTILLED_LORA_STRENGTH=0.8
LTX_HQ_DISTILLED_LORA_STRENGTH_STAGE_1=0.25
LTX_HQ_DISTILLED_LORA_STRENGTH_STAGE_2=0.5
LTX_LORA_PATHS=

MINIMUM_SECONDS_PER_VIDEO=6
SECONDS_PER_12_PROMPT_WORDS=1
MAX_LTX_SEGMENT_SECONDS=20
MAX_PROMPT_WORDS_PER_SEGMENT=145
MAX_AUTO_SEGMENTS=0
